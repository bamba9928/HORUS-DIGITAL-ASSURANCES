# ─── Sécurité Django ──────────────────────────────────────────────────────────
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=False

# Domaines autorisés, séparés par virgule (ex: api.horus.sn,horus.sn)
DJANGO_ALLOWED_HOSTS=

# ─── Base de données ──────────────────────────────────────────────────────────
# PostgreSQL obligatoire en production
# Format : postgres://user:password@host:5432/dbname
DATABASE_URL=
FRONTEND_BASE_URL=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@horus-assurances.sn
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ─── CORS / CSRF ──────────────────────────────────────────────────────────────
# URL complète du frontend, séparées par virgule (ex: https://horus.sn)
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# ─── Throttling ───────────────────────────────────────────────────────────────
# Limite de tentatives de connexion par IP (anti force brute)
AUTH_LOGIN_THROTTLE_RATE=10/min
# Limite d'appels vérification immatriculation par utilisateur (CGU ASS)
ASS_VERIFY_THROTTLE_RATE=30/min
# Limite sur le renouvellement / la révocation de jeton (aucun mot de passe n'y
# transite, d'où un plafond plus large que la connexion)
AUTH_TOKEN_REFRESH_THROTTLE_RATE=60/min

# ─── Sessions ─────────────────────────────────────────────────────────────────
# Durée de session en secondes (défaut : 12 h)
SESSION_COOKIE_AGE=43200

# ─── Jetons JWT (clients mobiles) ─────────────────────────────────────────────
# Ne concernent pas le front web, qui reste sur la session par cookie.
# Access court car un JWT déjà émis ne se révoque pas ; refresh long pour éviter
# une ressaisie du mot de passe à chaque ouverture de l'application.
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# ─── HTTPS ────────────────────────────────────────────────────────────────────
# Mettre à True uniquement après activation de HTTPS
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# True si Django est derrière un reverse proxy qui termine le TLS (nginx, traefik…)
USE_X_FORWARDED_PROTO=False
# Nombre de proxys de confiance devant Django. Sert de clé aux limitations de
# débit : sans lui, DRF prend l'en-tête X-Forwarded-For entier, que le client
# fournit — n'importe qui obtenait alors un compteur neuf à chaque requête.
# 1 = nginx seul. À passer à 2 si un CDN s'intercale devant.
NUM_PROXIES=1

# ─── Intégration Orange Money (Paiement Marchand Sonatel) ─────────────────────
# Sandbox : https://api.sandbox.orange-sonatel.com — prod : https://api.orange-sonatel.com
OM_BASE_URL=https://api.sandbox.orange-sonatel.com
# Générés en créant une application sur developer.orange-sonatel.com
# (une app sandbox, puis une app de production à faire activer par Sonatel).
OM_CLIENT_ID=
OM_CLIENT_SECRET=
# Code marchand à 6 chiffres attribué par Sonatel à l'ouverture du compte Marchand
OM_MERCHANT_CODE=
OM_MERCHANT_NAME=HORUS ASSUR
# Clé marchande optionnelle (en-tête X-Api-Key), seulement si le contrat en fournit une
OM_API_KEY=
# Durée de validité du QR de paiement (secondes, 86400 max côté OM)
OM_QR_VALIDITY_SECONDS=300
# Mock actif tant que les accès Sonatel ne sont pas fournis
OM_MOCK_ENABLED=True
OM_REAL_CALLS_ALLOWED=False
# Mock uniquement : délai avant confirmation simulée du paiement
OM_MOCK_CONFIRM_DELAY_SECONDS=15
# Le mock CONFIRME un paiement sans qu'un franc ne bouge : hors DEBUG, les
# parcours Orange Money simulés sont refusés. Ne mettre à True que sur un
# environnement de recette — JAMAIS sur l'instance qui sert de vrais clients.
OM_ALLOW_MOCK_IN_PRODUCTION=False

# Webhook OM — HTTPS obligatoire, doit être joignable publiquement.
# Vide : OM utilise le callback enregistré pour le code marchand
# (uv run python backend/scripts/om_sandbox_probe.py register-callback).
OM_CALLBACK_URL=
# Secret de l'endpoint partenaire, vérifie X-Sonatel-Signature (HMAC-SHA256).
# ÉCHEC FERMÉ : hors DEBUG, sans ce secret NI OM_CALLBACK_API_KEY, le webhook
# refuse toute notification (503) au lieu de les accepter anonymement.
OM_CALLBACK_SIGNING_SECRET=
# apiKey déclarée à l'enregistrement du callback ; OM la renvoie en Authorization: Basic.
OM_CALLBACK_API_KEY=
# Pages de retour du parcours MAX IT / Orange Money (facultatives)
OM_CALLBACK_SUCCESS_URL=
OM_CALLBACK_CANCEL_URL=

# ─── Intégration ASS ──────────────────────────────────────────────────────────
# URL de base API ASS. Les deux environnements sont des hôtes DISTINCTS :
#   Sandbox    : https://kiiraytest.lasecu-assurances.sn
#   Production : https://manager.ass-assurances.sn
ASS_BASE_URL=

# Segment {partner} de /api/v1/{partner}/... = le NOM DE PARTENAIRE attribué par
# ASS, pas le mot littéral "partner". La sandbox mutualisée répondait sur
# "partner" ; le compte nominatif Horus est "bambadieng". Se tromper de segment
# fait répondre 404 à TOUTES les routes — symptôme identique à une panne ASS.
ASS_API_PARTNER_SEGMENT=

# Basic Auth : le mot de passe est l'access_token fourni par ASS. Le username est
# indifférent côté sandbox ("ass" et "token" fonctionnent tous deux).
# ASS régénère le jeton quand elle restaure son instance → 401
# {"error": "Authentication"}. Réflexe : redemander la valeur courante à ASS.
ASS_USERNAME=
ASS_PASSWORD=

# CONTOURNEMENT TEMPORAIRE (constaté le 2026-08-12) — laisser vide en temps normal.
# Depuis la restauration de leur instance, l'Odoo d'ASS ne résout plus de base de
# données pour une requête en Basic Auth seul : toutes les routes /api/v1/partner/*
# répondent 404. Renseigner ici un cookie de session Odoo valide débloque les appels.
# Le cookie ne sert qu'à désigner la base — c'est toujours ASS_PASSWORD qui authentifie.
# Il EXPIRE : si les appels se mettent à répondre 401, c'est qu'il est périmé.
# À VIDER dès qu'ASS a corrigé son dbfilter — et TOUJOURS vide en production :
# l'instance de prod résout sa base sans cookie.
ASS_SESSION_ID=

# Frais de police en FCFA
ASS_POLICY_FEE=3000

# Endpoint d'annulation : /qrcode.mono.cancel (PDF) ou /qrcode.cancel (Postman).
# À fixer après confirmation d'ASS, sans redéploiement.
ASS_CANCEL_ENDPOINT=/qrcode.mono.cancel

# Seuil d'alerte stock QR (dashboard + statut low_stock)
ASS_QR_STOCK_ALERT_THRESHOLD=10

# Mettre à False en production pour activer les vrais appels ASS
ASS_MOCK_ENABLED=False
ASS_REAL_CALLS_ALLOWED=True
